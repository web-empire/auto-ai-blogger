{
	"name": "autoblog-ai",
	"version": "0.0.1",
	"description": "This is not just a content creator, its beyond the blogging.",
	"volta": {
		"node": "18.15.0"
	},
	"author": "",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"plugin",
		"portal",
		"dashboard"
	],
	"homepage": "https://github.com/web-empire/autoblog-ai#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/web-empire/autoblog-ai.git"
	},
	"bugs": {
		"url": "https://github.com/web-empire/autoblog-ai/issues"
	},
	"engines": {
		"npm": ">=9.5.0 <10.4.0",
		"node": ">=18.15.0 <19.0.0"
	},
	"main": "src/dashboard/DashboardApp.js",
	"dependencies": {
		"@google/generative-ai": "^0.21.0",
		"@lodder/grunt-postcss": "^3.1.1",
		"@wordpress/api-fetch": "^6.54.0",
		"@wordpress/data": "^9.27.0",
		"@wordpress/dom-ready": "^3.57.0",
		"grunt-bumpup": "^0.6.3",
		"grunt-contrib-concat": "^2.1.0",
		"grunt-contrib-cssmin": "^5.0.0",
		"grunt-contrib-uglify": "^5.2.2",
		"grunt-rtlcss": "^2.0.2",
		"grunt-text-replace": "^0.4.0",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-color": "^2.19.3",
		"react-dom": "^18.2.0",
		"react-router-dom": "^6.26.2"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^12.6.0",
		"@wordpress/i18n": "^4.2.4",
		"@wordpress/scripts": "^26.1.0",
		"autoprefixer": "^10.4.19",
		"grunt": "^1.4.1",
		"grunt-cli": "^1.4.3",
		"grunt-contrib-clean": "^2.0.0",
		"grunt-contrib-compress": "^2.0.0",
		"grunt-contrib-copy": "^1.0.0",
		"grunt-wp-readme-to-markdown": "^2.1.0",
		"postcss": "^8.4.38",
		"prettier": "npm:wp-prettier@2.6.2",
		"tailwindcss": "^3.4.3"
	},
	"scripts": {
		"start": "wp-scripts start",
		"build": "wp-scripts build && grunt minify && npm run fixer",
		"makepot": "wp i18n make-pot . --skip-audit --exclude='.dev,.github,.wordpress-org,docs,src,node_modules,tests,vendor,wordpress,artifact,.browserslistrc,postcss.config.js,tailwind.config.js,webpack.restriction.config.js,.eslintrc.js,.prettierrc.js,package.json,package-lock.json,*.json' languages/autoblog-ai.pot",
		"php-makepot": "php -d memory_limit=512M $(which wp) i18n make-pot wp-content/plugins/autoblog-ai wp-content/plugins/autoblog-ai/languages/autoblog-ai.pot --exclude='.dev,.github,.wordpress-org,docs,src,node_modules,tests,vendor,wordpress,artifact,.browserslistrc,postcss.config.js,tailwind.config.js,webpack.restriction.config.js,.eslintrc.js,.prettierrc.js,package.json,package-lock.json,*.json' --include='*.php,*/**/build/*.js'",
		"pretty": "prettier --check .",
		"pretty:fix": "prettier --write .",
		"lint-js": "wp-scripts lint-js",
		"lint-js:fix": "npm run pretty:fix && npm run lint-js -- --fix",
		"lint-css": "wp-scripts lint-style --allow-empty-input",
		"lint-css:fix": "npm run lint-css -- --fix",
		"lint-pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"plugin-zip": "wp-scripts plugin-zip",
		"scanner": "npm run lint-js && npm run lint-css && npm run lint-pkg-json && composer lint && composer phpstan && composer insights",
		"fixer": "npm run lint-js:fix && npm run lint-css:fix && composer format && composer phpstan && composer insights:fix"
	},
	"resolutions": {
		"react": "^18.3.1",
		"react-dom": "^18.2.0"
	}
}
